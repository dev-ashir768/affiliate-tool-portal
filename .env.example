# Backend base URL (no trailing slash). Used by Next.js BFF routes and proxy.
# Prefers API_URL; falls back to NEXT_PUBLIC_API_URL; then http://localhost:4000.
# Pair with sibling repo: https://github.com/dev-ashir768/affiliate-tool-apis (default PORT=4000)
API_URL=http://localhost:4000

# Optional client-visible override of the same base URL (rarely needed — API calls go through the BFF).
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth cookies (not env vars — fixed names in lib/auth/constants.ts):
#   access_token   httpOnly, path=/, maxAge ~15m (matches API ACCESS_TOKEN_TTL_SEC default)
#   refresh_token  httpOnly, path=/, maxAge ~7d  (matches API REFRESH_TOKEN_TTL_SEC default)
# Cookie `secure` follows NODE_ENV === "production". JWT secrets live only in the APIs repo.
