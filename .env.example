###############################################################################
# affiliate-tool-portal — environment
# Copy to .env. Next.js BFF + proxy talk to the APIs via these URLs.
# Sibling APIs: https://github.com/dev-ashir768/affiliate-tool-apis (PORT=4000)
###############################################################################

# Backend base URL (no trailing slash). Used by BFF routes and auth refresh proxy.
# Resolution order: API_URL → NEXT_PUBLIC_API_URL → http://localhost:4000
API_URL=http://localhost:4000

# Optional browser-visible override (rarely needed — UI calls portal BFF, not the API).
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Public site URL for Open Graph / metadata (no trailing slash). Production example:
# NEXT_PUBLIC_APP_URL=https://portal.dealhoper.com

# Same JWT_ACCESS_SECRET as affiliate-tool-apis — required for proxy/layout area guards.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!

# Same PORTAL_BFF_SECRET as APIs — required in production so auth responses include refreshToken.
PORTAL_BFF_SECRET=change-me-portal-bff-secret-min-16

# Cookie Secure override (default: true when NODE_ENV=production)
# COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Notes (not env vars)
# ---------------------------------------------------------------------------
# Auth cookies (lib/auth/constants.ts):
#   access_token   httpOnly, path=/, ~15m  — align with APIs ACCESS_TOKEN_TTL_SEC
#   refresh_token  httpOnly, path=/, ~7d   — align with APIs REFRESH_TOKEN_TTL_SEC
# Proxy verifies JWT signatures (jose) — never trust decode-only claims.
#
# Local pair:
#   APIs    CORS_ORIGINS=http://localhost:3000
#   Portal  API_URL=http://localhost:4000
#   TikTok  TIKTOK_SHOP_REDIRECT_URI=http://localhost:3000/shops/tiktok/callback
#           (set on APIs; Partner Center must match)
