# affiliate-tool-portal — copy to .env

API_URL=http://localhost:4000
# Public site URL for metadata / OG (production):
# NEXT_PUBLIC_APP_URL=https://portal.dealhoper.com

# Same values as affiliate-tool-apis (required)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
PORTAL_BFF_SECRET=change-me-portal-bff-secret-min-16

# Cookie Secure override (default: true when NODE_ENV=production)
# COOKIE_SECURE=true
