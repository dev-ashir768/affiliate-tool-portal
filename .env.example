API_URL=https://api.dealhoper.com
PORT=3001
NODE_ENV=development

NEXT_PUBLIC_APP_URL=https://portal.dealhoper.com

# Ed25519 public key (same JWT_PUBLIC_KEY as the API). Portal only verifies tokens.
JWT_PUBLIC_KEY=
# Fallback only when the API still signs HS256 (no JWT_PRIVATE_KEY there).
JWT_ACCESS_SECRET=
# Same value on portal + API.
PORTAL_BFF_SECRET=

COOKIE_SECURE=true
